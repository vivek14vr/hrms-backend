generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  WORK_FROM_HOME
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PAID
  PENDING
  PROCESSING
}

enum PayrollRunStatus {
  DRAFT
  REVIEW
  APPROVED
  PROCESSED
  PAID
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  passwordHash String
  role       UserRole
  employeeId String?    @unique
  isActive   Boolean    @default(true)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions   AuthSession[]
  reviewedAttendanceCorrections AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewer")
  createdPayrollRuns PayrollRun[] @relation("PayrollRunCreator")
  approvedPayrollRuns PayrollRun[] @relation("PayrollRunApprover")
  auditEvents AuditEvent[] @relation("AuditEventActor")
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveRequestReviewer")
  passwordResetTokens PasswordResetToken[]
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([role, isActive])
  @@index([lockedUntil])
  @@index([createdAt])
}

model AuthSession {
  id               String    @id
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model Employee {
  id                    String             @id @default(cuid())
  employeeCode          String             @unique
  firstName             String
  lastName              String
  email                 String             @unique
  phone                 String?
  avatarUrl             String?
  department            String
  designation           String
  employmentType        EmploymentType
  employmentStatus      EmploymentStatus   @default(ACTIVE)
  joiningDate           DateTime
  managerName           String?
  managerId             String?
  manager               Employee?          @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports         Employee[]         @relation("EmployeeManager")
  location              String?
  dateOfBirth           DateTime?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  baseSalary            Decimal            @db.Decimal(12, 2)
  scheduleId            String?
  schedule              WorkSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  user                  User?
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrectionRequest[]
  salarySlips           SalarySlip[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  compensationHistory   CompensationHistory[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([department])
  @@index([employmentStatus])
  @@index([designation])
  @@index([scheduleId])
  @@index([managerId])
  @@index([lastName, firstName])
}

model CompensationHistory {
  id            String   @id @default(cuid())
  employeeId    String
  effectiveFrom DateTime
  baseSalary    Decimal  @db.Decimal(12, 2)
  reason        String?
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

model EmployeeCodeSequence {
  id        String   @id
  nextValue Int
  updatedAt DateTime @updatedAt
}

model WorkSchedule {
  id                   String     @id @default(cuid())
  name                 String
  timezone             String
  workWeek             String
  shiftStart           String
  shiftEnd             String
  graceMinutes         Int
  overtimeAfterMinutes Int
  active               Boolean    @default(true)
  employees            Employee[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([active, name])
}

model AttendanceCorrectionRequest {
  id            String                     @id @default(cuid())
  employeeId    String
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  workHours     Decimal?                   @db.Decimal(4, 2)
  status        AttendanceStatus
  reason        String
  requestStatus AttendanceCorrectionStatus @default(PENDING)
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  employee      Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy    User?                      @relation("AttendanceCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([employeeId, date])
  @@index([requestStatus, createdAt])
  @@index([reviewedById])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  workHours  Decimal?         @db.Decimal(4, 2)
  overtimeHours Decimal?      @db.Decimal(4, 2)
  status     AttendanceStatus
  notes      String?
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
}

model SalarySlip {
  id                 String        @id @default(cuid())
  employeeId         String
  month              Int
  year               Int
  basicSalary        Decimal       @db.Decimal(12, 2)
  houseRentAllowance Decimal       @db.Decimal(12, 2)
  transportAllowance Decimal       @db.Decimal(12, 2)
  performanceBonus   Decimal       @db.Decimal(12, 2)
  providentFund      Decimal       @db.Decimal(12, 2)
  professionalTax    Decimal       @db.Decimal(12, 2)
  incomeTax          Decimal       @db.Decimal(12, 2)
  otherDeductions    Decimal       @db.Decimal(12, 2)
  grossSalary        Decimal       @db.Decimal(12, 2)
  totalDeductions    Decimal       @db.Decimal(12, 2)
  netSalary          Decimal       @db.Decimal(12, 2)
  paymentStatus      PaymentStatus @default(PENDING)
  paymentDate        DateTime?
  payrollRunId       String?
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun         PayrollRun?    @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([employeeId, month, year])
  @@index([year, month])
  @@index([paymentStatus])
  @@index([employeeId, year, month])
  @@index([payrollRunId])
}

model PayrollRun {
  id             String          @id @default(cuid())
  month          Int
  year           Int
  status         PayrollRunStatus @default(DRAFT)
  totalGross     Decimal         @db.Decimal(14, 2)
  totalDeductions Decimal        @db.Decimal(14, 2)
  totalNet       Decimal         @db.Decimal(14, 2)
  slipCount      Int             @default(0)
  createdById    String?
  approvedById   String?
  processedAt    DateTime?
  paidAt         DateTime?
  createdBy      User?           @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("PayrollRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  salarySlips    SalarySlip[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([month, year])
  @@index([status, year, month])
  @@index([createdById])
  @@index([approvedById])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json?
  actor       User?    @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model WorkspaceSettings {
  id                   String   @id
  name                 String
  timezone             String
  currency             String
  workWeek             String
  shiftStart           String   @default("09:00")
  shiftEnd             String   @default("18:00")
  graceMinutes         Int      @default(15)
  overtimeAfterMinutes Int      @default(480)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date, active])
}

model LeaveType {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  paid            Boolean         @default(true)
  annualAllowance Int
  active          Boolean         @default(true)
  balances        LeaveBalance[]
  requests        LeaveRequest[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([active, name])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Int
  used        Int       @default(0)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

model LeaveRequest {
  id           String             @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String
  status       LeaveRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reviewedBy   User?              @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([employeeId, startDate, endDate])
  @@index([status, createdAt])
  @@index([leaveTypeId, startDate])
  @@index([reviewedById])
}
